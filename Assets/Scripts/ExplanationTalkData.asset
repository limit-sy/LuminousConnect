  m_Script: {fileID: 11500000, guid: 572bb3b1d5706e245b3a0bc9f912f1bf, type: 3}
  m_Name: ExplanationTalkData
  m_EditorClassIdentifier: Assembly-CSharp::TalkData
  talks:
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u3054\u5354\u529B\u3001\u611F\u8B1D\u3057\u307E\u3059\u3088\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u3053\u306E\u5148\u306F\u3001\u304B\u3064\u3066\u300E\u30CA\u30AB\u300F\u3068\u547C\u3070\u308C\u305F\u5834\u6240\u2026\u2026\u3002\u4ECA\u306F\u305F\u3060\u306E\u3001\u5F62\u3092\u5931\u3063\u305F\u5883\u754C\u7DDA\u3067\u3059\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u3067\u306F\u3001\u3053\u306E\u300E\u30EB\u30DF\u30CA\u30B9\u30B9\u30C6\u30A3\u30C3\u30AF\u300F\u3092\u3042\u306A\u305F\u306B\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u79FB\u52D5\u306F\u3010\u65B9\u5411\u30AD\u30FC/\u5DE6\u30B9\u30C6\u30A3\u30C3\u30AF\u3011\n\u2026\u2026\u8996\u70B9\u306E\u64CD\u4F5C\u306F\u3010WASD/\u53F3\u30B9\u30C6\u30A3\u30C3\u30AF\u3011\u3067\u884C\u3044\u307E\u3059\u3002\n\u57FA\u672C\u3067\u3059\u3088\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u98DB\u3070\u3057\u305F\u3044\u65B9\u5411\u3078\u3001\u6253\u70B9\u3092\u52D5\u304B\u3057\u307E\u3057\u3087\u3046\u3002\n\u64CD\u4F5C\u306F\u3010\u65B9\u5411\u30AD\u30FC/\u5DE6\u30B9\u30C6\u30A3\u30C3\u30AF\u3011\u3002\n\u2026\u2026\u3044\u3044\u3067\u3059\u306D\uFF1F"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u3010C\u30AD\u30FC/\u25A1\u30DC\u30BF\u30F3\u3011\u3067\u30B2\u30FC\u30B8\u59CB\u52D5\u3002\u3082\u3046\u4E00\u5EA6\n\u62BC\u305B\u3070\u2026\u2026\u30B7\u30E7\u30C3\u30C8\uFF01\u3000\u7403\u304C\u653E\u305F\u308C\u307E\u3059\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u753B\u9762\u53F3\u4E0B\u306E\u30B2\u30FC\u30B8\u306E\u201D\u9577\u3055\u201D\u304C\u3001\u305D\u306E\u307E\u307E\u201D\u5A01\u529B\u201D\u3002\n\u529B\u3092\u8FBC\u3081\u3059\u304E\u306A\u3044\u3088\u3046\u2026\u2026\u3054\u6CE8\u610F\u3092"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u7403\u306F\u3001\u6253\u3064\u305F\u3073\u306B\u201D\u8F1D\u304D\u201D\u3092\u5931\u3044\u307E\u3059\u3002\n\u2026\u2026\u771F\u3063\u6697\u306B\u306A\u308B\u524D\u306B\u3001\u7403\u3092\u30B4\u30FC\u30EB\u307E\u3067\u904B\u3093\u3067\u304F\u3060\u3055\u3044\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u3002\u8AAC\u660E\u306F\u4EE5\u4E0A\u3067\u3059\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u8CB4\u65B9\u69D8\u306A\u3089\u3067\u304D\u308B\u306F\u305A\u3067\u3059\u3002\n\u3088\u308D\u3057\u304F\u3001\u304A\u9858\u3044\u3057\u307E\u3059\u3088\u3002"
