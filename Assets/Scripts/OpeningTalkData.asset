--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 572bb3b1d5706e245b3a0bc9f912f1bf, type: 3}
  m_Name: OpeningTalkData
  m_EditorClassIdentifier: Assembly-CSharp::TalkData
  talks:
  - speakerName: "\uFF1F\uFF1F\uFF1F"
    message: "\u2026\u2026\u304A\u3084\u304A\u3084\u3002\u3053\u308C\u306F\u73CD\u3057\u3044\u3002\u2026\u2026\u672C\u5F53\u306B\u304A\u73CD\u3057\u3044\u3002"
  - speakerName: "\uFF1F\uFF1F\uFF1F"
    message: "\u3053\u3093\u306A\u2026\u2026\u4E16\u754C\u306E\u9685\u3063\u3053\u306B\u3001\u5148\u5BA2\u304C\u3044\u3089\u3063\u3057\u3083\u308B\u3068\u306F\u3002"
  - speakerName: "\uFF1F\uFF1F\uFF1F"
    message: "\u5931\u793C\u3002\u5927\u4E08\u592B\u3067\u3059\u304B\uFF1F\u2026\u2026\u3072\u3069\u304F\u3046\u306A\u3055\u308C\u3066\u3044\u305F\u3088\u3046\u3067\u3059\u304C\u3002"
  - speakerName: "\uFF1F\uFF1F\uFF1F"
    message: "\u2026\u2026\u79C1\uFF1F\u305D\u3046\u3067\u3059\u306A\u2026\u2026"
  - speakerName: "\uFF1F\uFF1F\uFF1F"
    message: "\u3072\u3068\u307E\u305A\u3001\u201D\u6848\u5185\u4EBA\u201D\u3068\u3067\u3082\u304A\u547C\u3073\u304F\u3060\u3055\u3044\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u307B\u3046\u3002\u306A\u308B\u307B\u3069\u3002\u5225\u306E\u4E16\u754C\u304B\u3089\u3001\u3072\u3087\u3093\u306A\u3053\u3068\u3067\u8FF7\u3044\u8FBC\u3093\u3060\u2026\u2026\u3068\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u30D5\u30E0\u3002\u5B89\u5FC3\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u5143\u306E\u4E16\u754C\u306B\u623B\u308B\u65B9\u6CD5\u306A\u3089\u2026\u2026"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u79C1\u3001\u77E5\u3063\u3066\u3044\u308B\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3088\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u3002\u2026\u2026\u2026\u2026\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u3002\u3069\u3046\u3084\u3089\u3002\u8CB4\u65B9\u306B\u306F\u300E\u7279\u5225\u306A\u624D\u80FD\u300F\u304C\u3042\u308B\u3088\u3046\u3067\u3059\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u304A\u304A\u3001\u305D\u3046\u3060\uFF01\u305B\u3063\u304B\u304F\u304A\u6642\u9593\u304C\u3042\u308B\u306E\u306A\u3089\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u5C11\u3057\u3070\u304B\u308A\u3001\u79C1\u306E\u300E\u983C\u307E\u308C\u3054\u3068\u300F\u3092\u805E\u3044\u3066\u306F\u3044\u305F\u3060\u3051\u307E\u305B\u3093\u304B\uFF1F"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u3042\u3061\u3089\u306B\u3042\u308B\u88C5\u7F6E\u3002\u3042\u308C\u3092\u5149\u3067\u6E80\u305F\u3057\u3066\u307B\u3057\u3044\u306E\u3067\u3059\u3002\u2026\u2026\u305D\u3046\u3002\u3053\u306E\u300E\u7A2E\u5B50\u300F\u3092\u4F7F\u3063\u3066\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u3082\u3057\u304B\u3059\u308B\u3068\u2026\u2026\u3067\u3059\u3088\uFF1F\u7121\u4E8B\u306B\u9054\u6210\u3057\u305F\u305D\u306E\u6642\u306B\u306F\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u5143\u306E\u4E16\u754C\u3078\u306E\u6249\u304C\u3001\u3072\u3087\u3063\u3053\u308A\u9854\u3092\u51FA\u3059\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u8CB4\u65B9\u306B\u3068\u3063\u3066\u3082\u3001\u60AA\u3044\u304A\u8A71\u3067\u306F\u306A\u3044\u306F\u305A\u3002\u2026\u2026\u3069\u3046\u3067\u3059\u304B\uFF1F
      \u3084\u3063\u3066\u3044\u305F\u3060\u3051\u307E\u3059\u304B\uFF1F"
