  m_Script: {fileID: 11500000, guid: 572bb3b1d5706e245b3a0bc9f912f1bf, type: 3}
  m_Name: PostClearTalkData
  m_EditorClassIdentifier: Assembly-CSharp::TalkData
  talks:
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002\n\u3084\u308A\u307E\u3057\u305F\u306D\u3002\u2026\u2026\u3048\u3048\u3001\n\u672C\u5F53\u306B\u3001\u7D20\u6674\u3089\u3057\u3044\u30B7\u30E7\u30C3\u30C8\u3067\u3057\u305F\u3088\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u30D5\u30D5\u3002\n\u3084\u306F\u308A\u3001\u79C1\u306E\u76EE\u306B\u72C2\u3044\u306F\u306A\u304B\u3063\u305F\u3002\n\u3042\u306A\u305F\u306B\u306F\u3001\u7279\u5225\u306A\u201C\u624D\u80FD\u201D\u304C\u3042\u308B\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u304A\u3063\u3068\u3002\n\u305D\u3093\u306A\u306B\u9A5A\u304B\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002\n\u79C1\u306F\u305F\u3060\u306E\u3001\u304A\u7BC0\u4ECB\u306A\u201C\u6848\u5185\u4EBA\u201D\u3067\u3059\u304B\u3089\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u3067\u3059\u304C\u2026\u2026\u3002\n\u3053\u3053\u304B\u3089\u5148\u3078\u9032\u3080\u306B\u306F\u3001\u4ECA\u306E\u5149\u3067\u306F\n\u5C11\u3057\u2026\u2026\u5FC3\u3082\u3068\u306A\u3044\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u3053\u306E\u4E16\u754C\u306E\u201C\u672C\u5F53\u306E\u59FF\u201D\u2026\u2026\u3002\n\u305D\u308C\u3092\u77E5\u308B\u306B\u306F\u3001\u3082\u3046\u5C11\u3057\u3060\u3051\u3001\n\u3042\u306A\u305F\u81EA\u8EAB\u306E\u201C\u8F1D\u304D\u201D\u304C\u5FC5\u8981\u306A\u306E\u3067\u3059\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u2026\u2026\u304A\u697D\u3057\u307F\u306F\u3001\u3053\u308C\u304B\u3089\u3001\u3067\u3059\u3088\u3002\n\u6B21\u306E\u6E96\u5099\u304C\u6574\u3046\u307E\u3067\u3001\u3069\u3046\u304B\n\u3086\u3063\u304F\u308A\u3068\u3001\u7FBD\u3092\u4F11\u3081\u3066\u304F\u3060\u3055\u3044\u3002"
  - speakerName: "\u6848\u5185\u4EBA\u3068\u540D\u4E57\u308B\u7537"
    message: "\u305D\u308C\u3067\u306F\u2026\u2026\u307E\u305F\u3001\u304A\u4F1A\u3044\u3057\u307E\u3057\u3087\u3046\u3002"
  - speakerName: 
    message: "\u2015\u2015\u2015 \u7D9A\u304F"
